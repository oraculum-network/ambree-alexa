# Copy to .env (never commit it) or set these in your environment.
# Every value may stay empty: the server then runs in offline mode, open, on port 8080.

# Server
PORT=
HOST=
PUBLIC_ORIGIN=
ALLOWED_ORIGINS=
TRUST_PROXY_HOPS=
RATE_LIMIT_SCALE=

# Demo gate (SESSION_SECRET is required, 32+ characters, when DEMO_PASSCODE is set)
DEMO_PASSCODE=
SESSION_SECRET=

# LLM mode (offline mode without a key)
OPENROUTER_API_KEY=
AGENT_MODEL=
AGENT_FALLBACK_MODELS=
AGENT_PRICE_IN_PER_M=
AGENT_PRICE_OUT_PER_M=
AGENT_DAILY_USD=
AGENT_DAILY_TURNS=
MCP_URL=

# Live feeds
WEATHER_USER_AGENT=
FEEDS=

# Data
PLACES_FILE=

# Test only: point the feeds and the LLM at local mock servers
MET_URL=
GDACS_URL=
OPENROUTER_URL=
